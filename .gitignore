.godot/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Large AI models
*.ckpt
*.pth
*.pt
*.onnx
# ...but the trained checkpoints are ~250 KB each and ARE tracked on purpose, so
# the same model can be served on another machine without retraining. A
# checkpoint and ai/training/vocabulary.json must be committed together: card ids
# are assigned in first-encountered order, and nothing checks that the two agree.
!ai/python/checkpoints/**/*.pt

# Archived generations of recordings — same reason datasets/ is ignored, they are
# just too big for git. Keeps a bare `python -m mtgai.policy` meaning "the
# current generation" instead of every teacher ever recorded.
ai/training/archive/

# Large training data — recordings live in ai/training/datasets/, but only the
# folder skeleton is tracked; the .jsonl files are regenerated by running matches.
datasets/
!ai/training/datasets/
ai/training/datasets/*
!ai/training/datasets/.gdignore
!ai/training/datasets/README.md
training_data/
# MTGJSON bulk exports, unpacked
data/raw/cards.csv/
data/raw/cardRulings.csv/
data/raw/cardIdentifiers.csv/
data/raw/cardLegalities.csv/
data/raw/tokens.csv/
